# =========================================================
#  Variáveis de ambiente do site
#  Copie este arquivo para ".env.local" e preencha os valores.
#  No Vercel, cadastre as mesmas variáveis em:
#  Settings -> Environment Variables
# =========================================================

# URL do seu projeto Supabase (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave "service_role" do Supabase (Project Settings -> API -> service_role)
# ATENÇÃO: é uma chave SECRETA. Nunca exponha no front-end nem suba no git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi....
